{
  "hosting": [
    {
      "site": "jeux-tout-doux",
      "public": ".",
      "ignore": [
        "firebase.json",
        ".firebaserc",
        ".git/**",
        ".github/**",
        "firebase-debug.log"
      ]
    },
    {
      "target": "pr-preview",
      "public": ".",
      "ignore": [
        "firebase.json",
        ".firebaserc",
        ".git/**",
        ".github/**",
        "firebase-debug.log"
      ],
      "headers": [
        {
          "source": "**/*.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-store, max-age=0"
            }
          ]
        },
        {
          "source": "**/*.css",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-store, max-age=0"
            }
          ]
        },
        {
          "source": "/index.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-store, max-age=0"
            }
          ]
        }
      ]
    }
  ]
}
